{
  "name": "centry-client",
  "version": "1.0.1",
  "description": "Lightweight error tracking SDK for Centry",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/index.worker.d.ts",
      "import": "./dist/index.worker.mjs",
      "require": "./dist/index.worker.js"
    },
    "./node": {
      "types": "./dist/index.node.d.ts",
      "import": "./dist/index.node.mjs",
      "require": "./dist/index.node.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "tsup",
    "dev": "tsup --watch",
    "lint": "oxlint",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260528.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "happy-dom": "^20.9.0",
    "oxlint": "^1.67.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/las6/centry-client.git"
  },
  "license": "MIT"
}
