{
  "name": "centry-client",
  "version": "1.2.1",
  "description": "Lightweight error tracking SDK for Centry",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/index.worker.d.ts",
      "import": "./dist/index.worker.mjs",
      "require": "./dist/index.worker.js"
    },
    "./node": {
      "types": "./dist/index.node.d.ts",
      "import": "./dist/index.node.mjs",
      "require": "./dist/index.node.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run lint && npm run test && npm run build",
    "dev": "tsup --watch",
    "lint": "oxlint",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260627.1",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "happy-dom": "^20.10.6",
    "oxlint": "^1.71.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/las6/centry-client.git"
  },
  "license": "MIT"
}
